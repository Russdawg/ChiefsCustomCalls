# Copy this file to .env.local for local development, and add the same
# values in Vercel: Project Settings -> Environment Variables.
# .env.local is already git-ignored -- never commit real secrets.

# --- /admin (new product form) ---

# The password you'll type at chiefscustomcalls.com/admin. Pick something
# only you know; it's never stored anywhere except this env var.
ADMIN_PASSWORD=

# A GitHub Personal Access Token the /admin form uses to commit new products
# straight to this repo. Create one at:
#   https://github.com/settings/personal-access-tokens/new
# - Repository access: "Only select repositories" -> ChiefsCustomCalls
# - Permissions: Contents -> Read and write (that's the only one it needs)
GITHUB_TOKEN=

# owner/repo this token has access to.
GITHUB_REPO=Russdawg/ChiefsCustomCalls

# Branch new products get committed to. Leave unset to default to "main".
# GITHUB_BRANCH=main

# --- PayPal checkout buttons ---

# Your PayPal business email. Public by design (it's what the Buy Now /
# Add to Cart buttons submit to) -- do NOT put a password or API secret
# here, just the email address your PayPal account uses.
NEXT_PUBLIC_PAYPAL_BUSINESS_EMAIL=
